+
+/** 法務文書FeatureのNavigation Routeを定義する。 */
+object LegalDocumentRoutes {
+    /** 法務文書種別のRoute引数名。 */
+    const val ArgType = "legalDocumentType"
+
+    /** 法務文書画面のRouteパターン。 */
